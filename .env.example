# Browser-safe (public) values
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only secrets (never prefix with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Optional: lock the API to your site, e.g. https://your-domain.com
ALLOWED_ORIGIN=

# Public site URL, used for canonical tags, sitemap.xml and robots.txt (set once the domain is known)
VITE_SITE_URL=
